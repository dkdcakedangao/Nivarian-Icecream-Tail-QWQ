<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NivarianIcecreamTail</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);RIMWORLD_17</DefineConstants>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RimUnityReferenceDir Condition="'$(RimUnityReferenceDir)' == ''">$(MSBuildProjectDirectory)/../obj/1.7/RimUnityReferences</RimUnityReferenceDir>
    <ReleaseDirectory>$(MSBuildProjectDirectory)/../../1.7/Assemblies</ReleaseDirectory>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">E:/steam/steamapps/common/RimWorld</RimWorldDir>
    <NivarianDir Condition="'$(NivarianDir)' == ''">$(RimWorldDir)/Mods/Nivarian</NivarianDir>
    <HarmonyAssemblyPath Condition="'$(HarmonyAssemblyPath)' == ''">E:/steam/steamapps/workshop/content/294100/1127530465/1.7/Assemblies/0Harmony.dll</HarmonyAssemblyPath>
    <HarAssemblyPath Condition="'$(HarAssemblyPath)' == ''">E:/steam/steamapps/workshop/content/294100/839005762/1.7/Assemblies/AlienRace.dll</HarAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../**/*.cs" Exclude="../Tests/**;../obj/**;../bin/**;../1.7/obj/**;../1.7/bin/**;../MeleeAnimationCompatibility/**;../Abilities/MintBreathPreview.cs" />
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldDir)/UnityStubs.dll" Private="false" />
    <Reference Include="Waylith" HintPath="$(RimWorldDir)/Waylith.dll" Private="false" />
    <Reference Include="Waylith.UnityCompat" HintPath="$(RimWorldDir)/Waylith.UnityCompat.dll" Private="false" />
    <Reference Include="Nivarian_Race" HintPath="$(NivarianDir)/1.7/Core/Assemblies/Nivarian_Race.rimunity" Private="false" />
    <Reference Include="RimUnity.Core" HintPath="$(RimUnityReferenceDir)/RimUnity.Core.dll" Private="false" />
    <Reference Include="RimUnity" HintPath="$(RimUnityReferenceDir)/RimUnity.dll" Private="false" />
    <Reference Include="LumiParticle" HintPath="$(NivarianDir)/1.7/LumiParticle/Assemblies/LumiParticle.rimunity" Private="false" />
    <Reference Include="0Harmony" HintPath="$(HarmonyAssemblyPath)" Private="false" />
    <Reference Include="AlienRace" HintPath="$(HarAssemblyPath)" Private="false" />
  </ItemGroup>
  <Target Name="ValidateRimUnityReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RimUnityReferenceDir)/RimUnity.Core.dll') Or !Exists('$(RimUnityReferenceDir)/RimUnity.dll')" Text="Set RimUnityReferenceDir to the matching RimUnity compile-only References directory." />
    <Error Condition="!Exists('$(NivarianDir)/1.7/RU/Assemblies/RimUnity.Embedded.dll')" Text="Missing Nivarian RimUnity.Embedded.dll registration container." />
  </Target>
  <Target Name="PublishDeferredAssembly" AfterTargets="Build">
    <Error Condition="Exists('$(ReleaseDirectory)/NivarianIcecreamTail.dll')" Text="Remove the obsolete 1.7/Assemblies/NivarianIcecreamTail.dll before publishing; it loads before RimUnity is ready." />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(ReleaseDirectory)/NivarianIcecreamTail.rimunity" />
    <Copy SourceFiles="$(NivarianDir)/1.7/RU/Assemblies/RimUnity.Embedded.dll" DestinationFiles="$(ReleaseDirectory)/RimUnity.Embedded.dll" />
  </Target>
  <Target Name="CopyVersionDefinitions" AfterTargets="Build">
    <ItemGroup>
      <VersionDefs Include="../../1.6/Defs/**/*" />
      <VersionPatches Include="../../1.6/Patches/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(VersionDefs)" DestinationFiles="@(VersionDefs->'../../1.7/Defs/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VersionPatches)" DestinationFiles="@(VersionPatches->'../../1.7/Patches/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
