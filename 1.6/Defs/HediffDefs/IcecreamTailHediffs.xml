<?xml version="1.0" encoding="utf-8"?>
<!-- 舔尾巴的主要xml -->
<Defs>
  <HediffDef>
    <defName>IcecreamTailPlaceholder</defName>
    <label>冰淇淋尾巴</label>
    <hediffClass>NivarianIcecreamTail.Hediff_IcecreamTailPlaceholder</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="NivarianIcecreamTail.HediffCompProperties_IcecreamTailPlaceholder" />
      <li Class="NivarianIcecreamTail.HediffCompProperties_IcecreamTailFlavor" />
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>IcecreamTailRecovery</defName>
    <label>冰淇淋尾巴恢复中</label>
    <description>尾巴正在努力凝结新的冰淇淋~</description>
    <hediffClass>NivarianIcecreamTail.Hediff_IcecreamTailRecovery</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.001</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="NivarianIcecreamTail.HediffCompProperties_IcecreamTailRecovery" />
      <li Class="NivarianIcecreamTail.HediffCompProperties_IcecreamTailFlavor" />
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>IcecreamTailRecoveryHunger</defName>
    <label>尾巴努力生长中</label>
    <description>尾巴要长出香香甜甜的冰淇淋，多吃一点才有力气喵~</description>
    <hediffClass>NivarianIcecreamTail.Hediff_IcecreamTailRecoveryHunger</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <hungerRateFactorOffset>0.1</hungerRateFactorOffset>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>IcecreamTailEaterBuff</defName>
    <label>吃了原味冰淇淋尾巴</label>
    <description>甜甜凉凉的力量涌上来了。</description>
    <hediffClass>NivarianIcecreamTail.Hediff_IcecreamTailFlavorEaterBuff</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="NivarianIcecreamTail.TailEatingUtility+HediffCompProperties_IcecreamTailBuffDuration" />
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.1</MoveSpeed>
          <ShootingAccuracyPawn>1.1</ShootingAccuracyPawn>
          <MeleeDamageFactor>1.1</MeleeDamageFactor>
        </statFactors>
        <statOffsets>
          <ComfyTemperatureMax>10</ComfyTemperatureMax>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>IcecreamTailSlow</defName>
    <label>冰淇淋冻住啦！</label>
    <description>被冰淇淋尾巴冻得慢吞吞，移动速度减慢了。</description>
    <hediffClass>NivarianIcecreamTail.Hediff_IcecreamTailSlow</hediffClass>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>420</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="NivarianIcecreamTail.HediffCompProperties_IcecreamTailSlowVfx" />
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>0.5</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>IcecreamTailStrawberryEaterBuff</defName>
    <label>吃了草莓味冰淇淋尾巴</label>
    <description>草莓香气让身体轻飘飘，眼睛也亮晶晶；只是软软的力气不太适合近战。</description>
    <hediffClass>NivarianIcecreamTail.Hediff_IcecreamTailFlavorEaterBuff</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="NivarianIcecreamTail.TailEatingUtility+HediffCompProperties_IcecreamTailBuffDuration" />
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.1</MoveSpeed>
          <ShootingAccuracyPawn>1.4</ShootingAccuracyPawn>
          <AimingDelayFactor>0.8</AimingDelayFactor>
          <MeleeDamageFactor>0.8</MeleeDamageFactor>
        </statFactors>
        <statOffsets>
          <ComfyTemperatureMax>10</ComfyTemperatureMax>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>IcecreamTailVanillaEaterBuff</defName>
    <label>吃了香草味冰淇淋尾巴</label>
    <description>香草奶香轻轻托着身体，跑起来像踩在云朵上！</description>
    <hediffClass>NivarianIcecreamTail.Hediff_IcecreamTailFlavorEaterBuff</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="NivarianIcecreamTail.TailEatingUtility+HediffCompProperties_IcecreamTailBuffDuration" />
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>2.0</MoveSpeed>
          <WorkSpeedGlobal>1.5</WorkSpeedGlobal>
          <ConstructSuccessChance>1.2</ConstructSuccessChance>
        </statFactors>
        <statOffsets>
          <ComfyTemperatureMax>10</ComfyTemperatureMax>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>IcecreamTailChocolateEaterBuff</defName>
    <label>吃了巧克力味冰淇淋尾巴</label>
    <description>浓厚巧克力甜甜暖暖，脑袋清醒，讲话也更有底气。</description>
    <hediffClass>NivarianIcecreamTail.Hediff_IcecreamTailFlavorEaterBuff</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="NivarianIcecreamTail.TailEatingUtility+HediffCompProperties_IcecreamTailBuffDuration" />
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.5</MoveSpeed>
          <RestRateMultiplier>0.8</RestRateMultiplier>
          <SocialImpact>1.2</SocialImpact>
        </statFactors>
        <statOffsets>
          <ComfyTemperatureMax>10</ComfyTemperatureMax>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>1.5</postFactor>
          </li>
        </capMods>
      </li>
      </stages>
  </HediffDef>
  <HediffDef>
    <defName>IcecreamTailBeerEaterBuff</defName>
    <label>吃了啤酒味冰淇淋（一酒）</label>
    <description>我喜欢喝啤酒！我也喜欢吃冰淇淋！双倍快乐喵！</description>
    <hediffClass>NivarianIcecreamTail.Hediff_IcecreamTailFlavorEaterBuff</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>4</maxSeverity>
    <comps>
      <!-- debug入口，预留的。但是大概率用不上 -->

      <li Class="NivarianIcecreamTail.TailEatingUtility+HediffCompProperties_IcecreamTailBuffDuration" />
      <li Class="NivarianIcecreamTail.HediffCompProperties_IcecreamTailBeerFourVfx" />
      <li Class="NivarianIcecreamTail.HediffCompProperties_IcecreamTailBeerFourAbilities" />

    </comps>
    <!-- 神秘小巧思~孩子们，我都不知道这能行~ -->
    <!-- 大概是能行？ -->
    <!-- 居然真的能用阶段啊？ -->
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statFactors>
          <MoveSpeed>0.9</MoveSpeed>
          <ShootingAccuracyPawn>0.9</ShootingAccuracyPawn>
          <AimingDelayFactor>1.1</AimingDelayFactor>
          <MeleeDamageFactor>1.2</MeleeDamageFactor>
          <MeleeCooldownFactor>1.1</MeleeCooldownFactor>
          <MeleeHitChance>0.9</MeleeHitChance>
          <MeleeDodgeChance>1.1</MeleeDodgeChance>
          <WorkSpeedGlobal>0.9</WorkSpeedGlobal>
          <IncomingDamageFactor>0.9</IncomingDamageFactor>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.9</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <statFactors>
          <MoveSpeed>0.8</MoveSpeed>
          <ShootingAccuracyPawn>0.6</ShootingAccuracyPawn>
          <AimingDelayFactor>1.5</AimingDelayFactor>
          <MeleeDamageFactor>1.4</MeleeDamageFactor>
          <MeleeCooldownFactor>1.2</MeleeCooldownFactor>
          <MeleeHitChance>0.7</MeleeHitChance>
          <MeleeDodgeChance>1.2</MeleeDodgeChance>
          <WorkSpeedGlobal>0.7</WorkSpeedGlobal>
          <IncomingDamageFactor>0.8</IncomingDamageFactor>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.8</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <statFactors>
          <MoveSpeed>0.4</MoveSpeed>
          <ShootingAccuracyPawn>0.1</ShootingAccuracyPawn>
          <AimingDelayFactor>2.0</AimingDelayFactor>
          <MeleeDamageFactor>2.0</MeleeDamageFactor>
          <MeleeCooldownFactor>2.0</MeleeCooldownFactor>
          <MeleeHitChance>0.5</MeleeHitChance>
          <MeleeDodgeChance>0.7</MeleeDodgeChance>
          <WorkSpeedGlobal>0.5</WorkSpeedGlobal>
          <IncomingDamageFactor>0.7</IncomingDamageFactor>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.7</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <statFactors>
          <MoveSpeed>0.8</MoveSpeed>
          <ShootingAccuracyPawn>0.01</ShootingAccuracyPawn>
          <AimingDelayFactor>2.0</AimingDelayFactor>
          <MeleeDamageFactor>1.2</MeleeDamageFactor>
          <MeleeCooldownFactor>0.4</MeleeCooldownFactor>
          <MeleeHitChance>1.2</MeleeHitChance>
          <MeleeDodgeChance>2.0</MeleeDodgeChance>
          <WorkSpeedGlobal>0.1</WorkSpeedGlobal>
          <IncomingDamageFactor>0.4</IncomingDamageFactor>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.6</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>IcecreamTailMagicBody</defName>
    <label>魔身</label>
    <description>！爆！</description>
    <hediffClass>NivarianIcecreamTail.Hediff_IcecreamTailMagicBody</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="NivarianIcecreamTail.HediffCompProperties_IcecreamTailMagicBodyValidator" />
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>2.0</MoveSpeed>
          <MeleeCooldownFactor>0.5</MeleeCooldownFactor>
          <MeleeHitChance>1.5</MeleeHitChance>
          <MeleeDamageFactor>1.25</MeleeDamageFactor>
          <MeleeDodgeChance>1.5</MeleeDodgeChance>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>IcecreamTailBeerHangover</defName>
    <label>啤酒冰淇淋宿醉</label>
    <description>啤酒和冰淇淋的双倍快乐已经结束，只剩下晕乎乎的脑袋。</description>
    <hediffClass>NivarianIcecreamTail.Hediff_IcecreamTailBeerHangover</hediffClass>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <hungerRateFactor>0.9</hungerRateFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.9</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
