<Defs>
  <RecipeDef>
    <defName>MakeIcecreamTailFood</defName>
    <label>制作尾巴冰冰</label>
    <description>用“愛”制作尾巴冰冰。</description>
    <jobString>正在制作尾巴冰冰。</jobString>
    <workAmount>800</workAmount>
    <workSkill>Cooking</workSkill>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>NivarianIcecreamTail.IngredientValueGetter_TailIcecream</ingredientValueGetterClass>
    <recipeUsers>
      <li>Campfire</li>
      <li>FueledStove</li>
      <li>ElectricStove</li>
    </recipeUsers>
    <fixedIngredientFilter>
      <categories>
        <li>FoodRaw</li>
      </categories>
      <thingDefs>
        <li>MedicineHerbal</li>
        <li>Nivarian_Scale</li>
      </thingDefs>
    </fixedIngredientFilter>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>FoodRaw</li>
          </categories>
        </filter>
        <count>0.5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Nivarian_Scale</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <IcecreamTailFood>1</IcecreamTailFood>
    </products>
  </RecipeDef>
  <RecipeDef>
    <defName>MakeIcecreamTailRestoreIce</defName>
    <label>制作！冰！</label>
    <description>将涅瓦莲掉落的鳞片凝结成不容易融化的冰。</description>
    <jobString>正在制作！冰！。</jobString>
    <workAmount>400</workAmount>
    <workSkill>Cooking</workSkill>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <recipeUsers>
      <li>Campfire</li>
      <li>FueledStove</li>
      <li>ElectricStove</li>
    </recipeUsers>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Nivarian_Scale</li>
      </thingDefs>
    </fixedIngredientFilter>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Nivarian_Scale</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <products>
      <IcecreamTailRestoreIce>1</IcecreamTailRestoreIce>
    </products>
  </RecipeDef>
