<Defs>
  <RecipeDef>
    <defName>MakeIcecreamTailFrostberryStompedSeasoning</defName>
    <label>制作传统霜莓足酿酒味冰淇淋调味料</label>
    <description>将传统霜莓足酿酒与莓果、草药和稻米调制成传统霜莓足酿酒味冰淇淋调味料。</description>
    <jobString>正在制作传统霜莓足酿酒味冰淇淋调味料。</jobString>
    <workAmount>1200</workAmount>
    <workSkill>Intellectual</workSkill>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <researchPrerequisite>DrugProduction</researchPrerequisite>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Nivarian_FrostberryStompedWine</li>
        <li>RawBerries</li>
        <li>MedicineHerbal</li>
        <li>RawRice</li>
      </thingDefs>
    </fixedIngredientFilter>
    <ingredients>
      <li><filter><thingDefs><li>Nivarian_FrostberryStompedWine</li></thingDefs></filter><count>5</count></li>
      <li><filter><thingDefs><li>RawBerries</li></thingDefs></filter><count>5</count></li>
      <li><filter><thingDefs><li>MedicineHerbal</li></thingDefs></filter><count>2</count></li>
      <li><filter><thingDefs><li>RawRice</li></thingDefs></filter><count>5</count></li>
    </ingredients>
    <products>
      <IcecreamTailFrostberryStompedSeasoning>1</IcecreamTailFrostberryStompedSeasoning>
    </products>
  </RecipeDef>
