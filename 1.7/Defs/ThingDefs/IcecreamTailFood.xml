<?xml version="1.0" encoding="utf-8"?>
<!-- 灶台做的，食物类的xml -->
<Defs>
  <ThingDef ParentName="MealCooked">
    <defName>IcecreamTailFood</defName>
    <label>尾巴冰冰</label>
    <description>奇奇怪怪的冰淇淋。吃起来口感怪怪的，但是若是有贪吃的涅瓦莲吃了的话，则尾巴也会变成这种冰淇淋！</description>
    <graphicData>
      <texPath>Items/tail_ice</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>35</MarketValue>
      <WorkToMake>800</WorkToMake>
      <Nutrition>0.9</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealFine</preferability>
      <ingestEffect>EatVegetarian</ingestEffect>
      <outcomeDoers>
        <li Class="NivarianIcecreamTail.IngestionOutcomeDoer_TailIcecream" />
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Ingredients" />
    </comps>
  </ThingDef>
  <ThingDef ParentName="MealCooked">
    <defName>IcecreamTailRestoreIce</defName>
    <label>！冰！</label>
    <description>用涅瓦莲身上掉落鳞片做成的，没那么容易融化的冰。非常适合加到冰淇淋中。若冰龙吃了，可以直接回复自己的冰淇淋尾巴。</description>
    <graphicData>
      <texPath>Items/tail_ice_restore</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.7,0.7)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>12</MarketValue>
      <WorkToMake>400</WorkToMake>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealSimple</preferability>
      <ingestEffect>EatVegetarian</ingestEffect>
      <outcomeDoers>
        <li Class="NivarianIcecreamTail.IngestionOutcomeDoer_TailRestoreIce" />
      </outcomeDoers>
    </ingestible>
  </ThingDef>
</Defs>
