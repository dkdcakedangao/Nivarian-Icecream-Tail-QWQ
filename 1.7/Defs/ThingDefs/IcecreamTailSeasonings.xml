<Defs>
  <ThingDef ParentName="DrugPillBase">
    <defName>IcecreamTailMilkSeasoning</defName>
    <label>牛奶味冰淇淋调味料</label>
    <description>已有冰淇淋尾巴的涅瓦莲使用后，可将成熟或恢复中的尾巴切换为对应口味。\n\n最经典的牛奶风味，没有多余的花样~吃过这样的尾巴，脚步、准头和力气都会好上一点，也更能忍受炎热。原味总有原味的好。</description>
    <graphicData>
      <texPath>Items/seasoning/seasoning_milk</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.7,0.7)</drawSize>
    </graphicData>
    <stackLimit>50</stackLimit>
    <statBases>
      <MarketValue>14</MarketValue>
      <Mass>0.05</Mass>
    </statBases>
    <ingestible>
      <drugCategory>Medical</drugCategory>
      <ingestCommandString>使用{0}进行调味</ingestCommandString>
      <ingestReportString>正在使用{0}进行调味。</ingestReportString>
      <outcomeDoers>
        <li Class="NivarianIcecreamTail.IngestionOutcomeDoer_IcecreamTailSeasoning" />
      </outcomeDoers>
    </ingestible>
    <modExtensions>
      <li Class="NivarianIcecreamTail.IcecreamTailFlavorExtension">
        <flavor>IcecreamTailFlavorOriginal</flavor>
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_Drug">
        <listOrder>200</listOrder>
      </li>
    </comps>
  </ThingDef>
